{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tlaku",
  "version": "0.1.0",
  "identifier": "org.tlaku.app",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tlaku",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**",
            "$DOCUMENT/**",
            "$DESKTOP/**",
            "$DOWNLOAD/**",
            "$PICTURE/**",
            "/Volumes/**",
            "/media/**",
            "/mnt/**"
          ],
          "deny": [
            "$HOME/Library/**",
            "$HOME/.*/**"
          ],
          "requireLiteralLeadingDot": true
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "category": "GraphicsAndDesign",
    "publisher": "tlaku contributors",
    "copyright": "© 2026 tlaku contributors",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "shortDescription": "Software libre para grabar y cortar con láser",
    "longDescription": "Tlaku es software libre (licencia MIT) para preparar y enviar trabajos a cortadoras y grabadoras láser: importa SVG, DXF e imágenes, organiza capas y ajustes de corte, planifica el recorrido, estima el tiempo y controla máquinas GRBL por puerto serie.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": [
          "es-ES",
          "en-US"
        ]
      }
    },
    "linux": {
      "deb": {
        "section": "graphics",
        "priority": "optional",
        "depends": [
          "libudev1"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
